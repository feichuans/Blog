---
import { ChatDock } from "@/components/chat/ChatDock";
import { PresenceLayer } from "@/components/presence/PresenceLayer";
import {
  PRESENCE_SITE_ROOM,
  presencePathFromLocation,
} from "@/lib/presence/url";

const path = presencePathFromLocation(Astro.url.pathname);
const { inNav = false } = Astro.props;
const placement = inNav ? "nav" : "fixed";
---

<PresenceLayer
  client:load
  room={PRESENCE_SITE_ROOM}
  path={path}
  placement={placement}
/>
<ChatDock client:load placement={placement} />
