---
import BaseHead from "@/components/layout/BaseHead.astro";
import PresenceIsland from "@/components/presence/PresenceIsland.astro";

type Variant =
  | "light"
  | "lightWheel085"
  | "default"
  | "standard"
  | "soft"
  | "steady";

interface Props {
  variant: Variant;
}

const { variant } = Astro.props;

const variants = {
  light: {
    title: "Light Touch",
    eyebrow: "lerp 0.12 / wheel 1",
    description: "更跟手，阻尼更少，读文章时响应更直接。",
    config: {
      lerp: 0.12,
      wheelMultiplier: 1,
      smoothWheel: true,
    },
    accent: "#7457d6",
    peer: [],
  },
  lightWheel085: {
    title: "Light Wheel 0.85",
    eyebrow: "lerp 0.12 / wheel 0.85",
    description: "保留 Light 的跟手阻尼，降低单次滚轮输入距离。",
    config: {
      lerp: 0.12,
      wheelMultiplier: 0.85,
      smoothWheel: true,
    },
    accent: "#6b69c9",
    peer: [],
  },
  default: {
    title: "Default",
    eyebrow: "official defaults",
    description: "不传配置，直接使用 Lenis 当前默认参数。",
    config: {},
    accent: "#5c6b44",
    peer: [],
  },
  standard: {
    title: "Standard",
    eyebrow: "lerp 0.1 / wheel 1",
    description: "接近官方默认，社区教程最常见的基础写法。",
    config: {
      lerp: 0.1,
      wheelMultiplier: 1,
      smoothWheel: true,
    },
    accent: "#b85d3a",
    peer: [],
  },
  soft: {
    title: "Soft",
    eyebrow: "lerp 0.05 / wheel 1",
    description: "更柔、更拖尾，适合强视觉页面，文章阅读可能偏慢。",
    config: {
      lerp: 0.05,
      wheelMultiplier: 1,
      smoothWheel: true,
    },
    accent: "#216e6c",
    peer: [],
  },
  steady: {
    title: "Steady",
    eyebrow: "lerp 0.1 / wheel 0.7",
    description: "滚轮输入被压低，更稳、更慢，常见于 Webflow/Shopify 示例。",
    config: {
      lerp: 0.1,
      wheelMultiplier: 0.7,
      smoothWheel: true,
    },
    accent: "#5c6b44",
    peer: [],
  },
} satisfies Record<Variant, {
  title: string;
  eyebrow: string;
  description: string;
  config: Record<string, unknown>;
  accent: string;
  peer: [string, string][];
}>;

const current = variants[variant];
const pageTitle = `Lenis ${current.title}`;
const blocks = Array.from({ length: 24 }, (_, index) => index + 1);
---

<!doctype html>
<html lang="zh-cn">
  <head>
    <BaseHead
      title={pageTitle}
      description="Lenis 滚动手感对比实验页"
    />
  </head>
  <body style={`--accent:${current.accent}`}>
    <PresenceIsland />
    <main
      class="lenis-stage"
      data-lenis-config={JSON.stringify(current.config)}
      data-variant={variant}
    >
      <nav class="switcher" aria-label="Lenis 参数页面切换">
        <a href="/lenis/light" class:list={[variant === "light" && "active"]}>
          Light
        </a>
        <a
          href="/lenis/light-wheel-085"
          class:list={[variant === "lightWheel085" && "active"]}
        >
          Light 0.85
        </a>
        <a
          href="/lenis/default"
          class:list={[variant === "default" && "active"]}
        >
          Default
        </a>
        <a
          href="/lenis/standard"
          class:list={[variant === "standard" && "active"]}
        >
          Standard
        </a>
        <a href="/lenis/soft" class:list={[variant === "soft" && "active"]}>
          Soft
        </a>
        <a href="/lenis/steady" class:list={[variant === "steady" && "active"]}>
          Steady
        </a>
      </nav>

      <div class="progress" aria-hidden="true">
        <span></span>
      </div>

      <section class="panel hero" data-panel="01">
        <div class="copy">
          <p class="eyebrow">{current.eyebrow}</p>
          <h1>{current.title}</h1>
          <p>{current.description}</p>
        </div>
        <div class="rail" aria-hidden="true">
          <span class="orb"></span>
          <span class="rail-line"></span>
        </div>
      </section>

      <section class="panel motion-lab" data-panel="02">
        <div class="pin-board">
          <p class="eyebrow">ScrollTrigger scrub</p>
          <h2>看方块追随滚动进度的迟滞感</h2>
          <div class="track" aria-hidden="true">
            <span class="runner runner-a"></span>
            <span class="runner runner-b"></span>
            <span class="runner runner-c"></span>
          </div>
        </div>
      </section>

      <section class="panel texture" data-panel="03">
        <div class="grid" aria-hidden="true">
          {blocks.map((block) => <span style={`--i:${block}`}></span>)}
        </div>
        <div class="copy">
          <p class="eyebrow">Three viewport scroll</p>
          <h2>同样距离，只比较滚轮阻尼</h2>
          <p>
            在三个页面之间切换，用相同滚轮力度滚动。这里的几何块、标尺和进度条会暴露每套参数的响应差异。
          </p>
        </div>
      </section>
    </main>

    <script>
      import Lenis from "lenis";
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);

      const stage = document.querySelector(".lenis-stage");
      const variant = stage.dataset.variant;
      const parsedConfig = JSON.parse(stage.dataset.lenisConfig);
      const lenisConfig = {
        ...parsedConfig,
        easing:
          parsedConfig.easing === "expoOut"
            ? (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t))
            : undefined,
      };

      Object.keys(lenisConfig).forEach((key) => {
        if (lenisConfig[key] === undefined) {
          delete lenisConfig[key];
        }
      });

      const lenis = new Lenis(lenisConfig);
      window.lenisFeelDemo = lenis;

      lenis.on("scroll", ScrollTrigger.update);

      gsap.ticker.add((time) => {
        lenis.raf(time * 1000);
      });
      gsap.ticker.lagSmoothing(0);

      gsap.to(".progress span", {
        scaleX: 1,
        ease: "none",
        scrollTrigger: {
          trigger: ".lenis-stage",
          start: "top top",
          end: "bottom bottom",
          scrub: true,
        },
      });

      gsap.to(".orb", {
        y: "62vh",
        rotation: variant === "cinema" ? 70 : 36,
        ease: "none",
        scrollTrigger: {
          trigger: ".hero",
          start: "top top",
          end: "bottom top",
          scrub: true,
        },
      });

      gsap.to(".runner-a", {
        xPercent: 620,
        ease: "none",
        scrollTrigger: {
          trigger: ".motion-lab",
          start: "top bottom",
          end: "bottom top",
          scrub: true,
        },
      });

      gsap.to(".runner-b", {
        xPercent: 450,
        rotation: 180,
        ease: "none",
        scrollTrigger: {
          trigger: ".motion-lab",
          start: "top 80%",
          end: "bottom 20%",
          scrub: 0.35,
        },
      });

      gsap.to(".runner-c", {
        xPercent: 300,
        scale: 1.65,
        ease: "none",
        scrollTrigger: {
          trigger: ".motion-lab",
          start: "top 65%",
          end: "bottom 15%",
          scrub: 0.7,
        },
      });

      gsap.to(".grid span", {
        y: (index) => (index % 2 ? -36 : 42),
        rotation: (index) => (index % 3) * 22,
        opacity: 0.95,
        stagger: 0.012,
        ease: "none",
        scrollTrigger: {
          trigger: ".texture",
          start: "top bottom",
          end: "bottom top",
          scrub: true,
        },
      });

      window.addEventListener("beforeunload", () => {
        ScrollTrigger.getAll().forEach((trigger) => trigger.kill());
        lenis.destroy();
      });
    </script>

    <style>
      :global(*) {
        box-sizing: border-box;
      }

      :global(html),
      :global(body) {
        height: auto;
        min-height: 100%;
        overflow: auto;
        cursor: auto;
        background:
          linear-gradient(90deg, rgb(30 28 24 / 0.05) 1px, transparent 1px),
          linear-gradient(rgb(30 28 24 / 0.05) 1px, transparent 1px),
          #f1eadf;
        background-size: 72px 72px;
        color: #221e1b;
      }

      :global(body) {
        margin: 0;
        font-family:
          "Maple Mono NF CN",
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
      }

      :global(body *) {
        cursor: auto;
      }

      :global(a),
      :global(button) {
        cursor: pointer;
      }

      .lenis-stage {
        position: relative;
        min-height: 300vh;
      }

      .switcher {
        position: fixed;
        z-index: 20;
        top: 22px;
        right: 22px;
        display: flex;
        gap: 6px;
        padding: 6px;
        border: 1px solid rgb(34 30 27 / 0.18);
        background: rgb(241 234 223 / 0.82);
        backdrop-filter: blur(18px);
      }

      .switcher a {
        min-width: 82px;
        padding: 9px 12px;
        color: rgb(34 30 27 / 0.68);
        font-size: 13px;
        text-align: center;
        text-decoration: none;
      }

      .switcher a.active {
        background: var(--accent);
        color: #fff9ed;
      }

      .progress {
        position: fixed;
        z-index: 30;
        top: 0;
        left: 0;
        width: 100%;
        height: 5px;
        background: rgb(34 30 27 / 0.12);
        transform-origin: left;
      }

      .progress span {
        display: block;
        width: 100%;
        height: 100%;
        background: var(--accent);
        transform: scaleX(0);
        transform-origin: left;
      }

      .panel {
        position: relative;
        min-height: 100vh;
        padding: clamp(28px, 6vw, 88px);
      }

      .panel::after {
        content: attr(data-panel);
        position: absolute;
        right: clamp(22px, 5vw, 72px);
        bottom: 24px;
        color: rgb(34 30 27 / 0.18);
        font-family: "Maple Mono NF CN", system-ui, sans-serif;
        font-size: clamp(64px, 13vw, 180px);
        line-height: 0.8;
      }

      .hero {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(180px, 28vw);
        align-items: center;
        gap: clamp(32px, 7vw, 110px);
      }

      .copy {
        max-width: 860px;
      }

      .eyebrow {
        margin: 0 0 18px;
        color: var(--accent);
        font-size: clamp(13px, 1.3vw, 17px);
        letter-spacing: 0;
      }

      h1,
      h2,
      p {
        margin: 0;
      }

      h1,
      h2 {
        max-width: 980px;
        font-family: "Maple Mono NF CN", system-ui, sans-serif;
        font-weight: 500;
        letter-spacing: 0;
      }

      h1 {
        font-size: clamp(64px, 12vw, 168px);
        line-height: 0.86;
      }

      h2 {
        font-size: clamp(40px, 7vw, 112px);
        line-height: 0.95;
      }

      .copy > p:last-child {
        max-width: 560px;
        margin-top: 24px;
        color: rgb(34 30 27 / 0.68);
        font-size: clamp(16px, 1.5vw, 22px);
        line-height: 1.65;
      }

      .rail {
        position: relative;
        height: 76vh;
        border-left: 1px solid rgb(34 30 27 / 0.2);
      }

      .rail-line {
        position: absolute;
        inset: 0 auto 0 8px;
        width: 14px;
        background: repeating-linear-gradient(
          to bottom,
          rgb(34 30 27 / 0.52) 0 2px,
          transparent 2px 24px
        );
      }

      .orb {
        position: absolute;
        top: 0;
        left: -32px;
        display: block;
        width: clamp(44px, 7vw, 92px);
        aspect-ratio: 1;
        border: 2px solid rgb(34 30 27 / 0.78);
        background:
          linear-gradient(135deg, transparent 47%, rgb(34 30 27 / 0.75) 48% 52%, transparent 53%),
          var(--accent);
      }

      .motion-lab {
        display: flex;
        align-items: center;
      }

      .pin-board {
        width: min(1080px, 100%);
      }

      .track {
        position: relative;
        width: min(920px, 76vw);
        height: 260px;
        margin-top: clamp(42px, 8vw, 96px);
        border-top: 1px solid rgb(34 30 27 / 0.2);
        border-bottom: 1px solid rgb(34 30 27 / 0.2);
      }

      .track::before,
      .track::after {
        content: "";
        position: absolute;
        top: 0;
        bottom: 0;
        width: 1px;
        background: rgb(34 30 27 / 0.2);
      }

      .track::before {
        left: 33%;
      }

      .track::after {
        left: 66%;
      }

      .runner {
        position: absolute;
        left: 0;
        display: block;
        width: 54px;
        aspect-ratio: 1;
        background: var(--accent);
      }

      .runner-a {
        top: 36px;
      }

      .runner-b {
        top: 104px;
        width: 42px;
        border-radius: 50%;
        background: #221e1b;
      }

      .runner-c {
        top: 174px;
        width: 34px;
        background: transparent;
        border: 2px solid var(--accent);
      }

      .texture {
        display: grid;
        grid-template-columns: minmax(240px, 0.82fr) minmax(280px, 0.7fr);
        align-items: center;
        gap: clamp(32px, 8vw, 124px);
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(6, minmax(30px, 1fr));
        gap: clamp(10px, 1.4vw, 20px);
        max-width: 620px;
      }

      .grid span {
        display: block;
        aspect-ratio: 1;
        opacity: 0.42;
        background:
          linear-gradient(135deg, rgb(255 249 237 / 0.58), transparent),
          color-mix(in srgb, var(--accent), #221e1b calc(var(--i) * 2%));
      }

      @media (max-width: 760px) {
        .switcher {
          top: 12px;
          right: 12px;
          left: 12px;
        }

        .switcher a {
          flex: 1;
          min-width: 0;
        }

        .hero,
        .texture {
          grid-template-columns: 1fr;
        }

        .hero {
          align-content: center;
          padding-top: 96px;
        }

        .rail {
          height: 24vh;
          margin-left: 32px;
        }

        .track {
          width: 100%;
        }
      }
    </style>
  </body>
</html>
