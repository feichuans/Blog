---
// Friends —— 邮票墙友链页。
// 技术来自 quickDemos/stamp-impasto（React + three.js 烫金/喷砂 shader），
// 数据换成朋友与常读站点。邮票墙按屏往下接，滚动跟同一条时间线；
// 友链表单是右下角 Motion layoutId 翻转按钮。
import BaseHead from "@/components/layout/BaseHead.astro";
import SiteMenu from "@/components/layout/SiteMenu.astro";
import ThemeToggle from "@/components/layout/ThemeToggle.astro";
import { FriendFormDock } from "@/components/friends/FriendFormDock";
import { StampGallery } from "@/components/friends/StampGallery";
import "@/styles/tailwind.css";
import type { FriendItem } from "@/components/friends/stamps";

const friends: FriendItem[] = [
  {
    name: "Kilokite",
    url: "blog.kt.sb",
    desc: "后来喝中药调好了",
    kind: "互链",
    image: "/images/friends/kilokite.jpg",
  },
  { name: "云游君", url: "yunyoujun.cn", desc: "一个想成为夏日和风的少年", kind: "互链" },
  { name: "Tw93", url: "tw93.fun", desc: "折腾一些有意思的开源小工具", kind: "互链" },
  { name: "Xuanwo", url: "xuanwo.io", desc: "通过开源和 Rust 实现数据自由", kind: "互链" },
  { name: "Anthony Fu", url: "antfu.me", desc: "Vue / Vite core team, 无数工具的作者", kind: "互链" },
  { name: "Innei", url: "innei.in", desc: "写代码，也写生活里的琐碎念头", kind: "互链" },
  { name: "Ovilia", url: "zhangwenli.com", desc: "数据可视化与创意编程", kind: "互链" },
  { name: "斜杠青年", url: "slashwithme.dev", desc: "在设计和工程之间来回横跳", kind: "互链" },
  { name: "苏卡卡", url: "sukaka.top", desc: "记录一些前端踩坑和阅读笔记", kind: "互链" },
];

const reading: FriendItem[] = [
  { name: "Rauno Freiberg", url: "rauno.me", desc: "界面细节与交互质感的教科书", kind: "常读" },
  { name: "Josh W. Comeau", url: "joshwcomeau.com", desc: "把 CSS 讲透的交互式长文", kind: "常读" },
  { name: "Emil Kowalski", url: "emilkowal.ski", desc: "动效与组件设计的第一性思考", kind: "常读" },
];

const all: FriendItem[] = [...friends, ...reading];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead
      title="Friends · Feichuan"
      description="一版寄给彼此的邮票：互链的朋友、常读的站点，和交换友链的方式。"
      ogType="website"
    />
  </head>
  <body class="friends-page">
    <SiteMenu />
    <ThemeToggle />

    <main>
      <section class="stamp-hero" aria-label="朋友与常读站点">
        <header class="page-head">
          <p class="stamp-kicker">{friends.length} sites · {reading.length} reading</p>
          <h1>Friends</h1>
          <article><p>一版寄给彼此的邮票。鼠标扫过去看烫金，点一张它会浮到眼前。</p></article>
        </header>
        <StampGallery client:only="react" items={all} />
        <FriendFormDock client:only="react" />
      </section>
    </main>
  </body>
</html>

<style is:global>
  /* ── paper 基底：与 about.astro 同一种纸面语言 ──
   *
   * 原本四个变量是写死的亮色（#f5f4ed / 黑色 alpha），暗色下整页留在亮面。
   * 改为引用 --fc-*，跟随 data-fc-theme 切换。
   *
   * 同时补两个变量，把散落各处的「黑色 alpha 叠在纸上」收敛掉：
   *   --paper-surface  卡片/输入框的浮起面（原 rgba(255,255,255,0.4~0.5)）
   *   --paper-wash     hover 的极弱底（原 rgba(0,0,0,0.05)）
   * 这两种写法在暗底是反的 —— 白 alpha 会发光，黑 alpha 会消失。 */
  :root {
    --paper-bg: var(--fc-surface-page);
    --paper-text: var(--fc-ink-meta);
    --paper-strong: var(--fc-ink);
    --paper-line: var(--fc-border-strong);
    --paper-surface: var(--fc-surface-raised);
    --paper-wash: color-mix(in oklab, var(--fc-ink) 6%, transparent);
  }
  html {
    overflow-x: clip;
    overflow-y: auto;
    background: var(--paper-bg);
  }
  body {
    min-height: 100%;
    margin: 0;
    color: var(--paper-text);
    background: var(--paper-bg);
    font-family: "Maple Mono NF CN", system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  * { box-sizing: border-box; }
  a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--paper-line);
    text-underline-offset: 2px;
    transition: color 0.3s ease, text-decoration-color 0.3s ease;
  }
  a:hover { color: var(--paper-strong); text-decoration-color: currentColor; }
  a:focus-visible, button:focus-visible { outline: 2px solid var(--fc-border-focus); outline-offset: 3px; }

  main { position: relative; }

  /* 邮票墙按屏往下接；页头浮在第一屏上 */
  .stamp-hero {
    position: relative;
    width: 100%;
    min-height: 100svh;
    padding-bottom: 28vh;
  }
  .stamp-hero .stamp-stage {
    position: relative;
  }
  .page-head {
    position: absolute;
    z-index: 4;
    top: max(88px, calc(env(safe-area-inset-top, 0px) + 72px));
    inset-inline-start: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: min(36rem, calc(100% - 40px));
    max-width: 640px;
    padding-inline: 24px;
    pointer-events: none;
  }
  .stamp-kicker {
    margin: 0;
    color: var(--paper-text);
    font-size: 12px;
    letter-spacing: 0.08em;
    line-height: 18px;
  }
  .page-head h1 {
    margin: 0;
    color: var(--paper-strong);
    font-size: 16px;
    font-weight: 600;
    line-height: 24px;
  }
  article { font-size: 16px; line-height: 28px; }
  article p { margin: 0; max-width: 36ch; }

  /* 灯箱打开时，浮层文字和友链入口退到后面去 */
  .page-head,
  .friend-dock {
    transition: filter 0.28s ease, opacity 0.28s ease;
  }
  body.has-stamp-viewer {
    overflow: hidden;
  }
  html:has(body.has-stamp-viewer) {
    overflow: hidden;
  }
  body.has-stamp-viewer .page-head,
  body.has-stamp-viewer .friend-dock {
    filter: blur(14px);
    opacity: 0.58;
    pointer-events: none;
  }

  @media (max-width: 640px) {
    .page-head {
      top: max(76px, calc(env(safe-area-inset-top, 0px) + 60px));
      width: min(100%, calc(100% - 32px));
      padding-inline: 20px;
      gap: 10px;
    }
    article { font-size: 14px; line-height: 22px; }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; }
  }
</style>
