---
import { SignatureGlassDemo } from '@/components/effects/GlassSignature'
import RealtimeIsland from "@/components/realtime/RealtimeIsland.astro";
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Glass Signature Demo</title>
  </head>
  <body>
    <RealtimeIsland />
    <SignatureGlassDemo client:only="react" />
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    min-height: 100%;
    background: #efe9dd;
  }

  body {
    font-family: "Maple Mono NF CN", ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
  }

  .signature-scene {
    position: relative;
    width: 100vw;
    min-height: 300vh;
    color: #332d25;
    isolation: isolate;
    background:
      radial-gradient(ellipse at 24% 18%, rgb(255 248 218 / 0.46), transparent 34%),
      linear-gradient(180deg, rgb(239 233 221), rgb(217 200 168));
  }

  .signature-scene::before {
    position: fixed;
    inset: -12%;
    content: "";
    background:
      radial-gradient(ellipse 34% 18% at 20% 24%, rgb(255 236 166 / 0.32), transparent 68%),
      radial-gradient(ellipse 28% 16% at 76% 18%, rgb(91 111 61 / 0.18), transparent 72%),
      linear-gradient(126deg, transparent 0 28%, rgb(65 88 61 / 0.13) 29% 31%, transparent 32% 100%);
    filter: blur(14px);
    transform: rotate(-7deg);
    animation: dapple-drift 16s ease-in-out infinite alternate;
    z-index: 0;
  }

  .signature-scene::after {
    position: fixed;
    inset: 0;
    content: "";
    background-image:
      linear-gradient(rgb(48 71 58 / 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgb(48 71 58 / 0.045) 1px, transparent 1px);
    background-size: 38px 38px;
    mask-image: radial-gradient(circle at 50% 48%, black 0 46%, transparent 74%);
    opacity: 0.28;
    z-index: 1;
  }

  .signature-filter-bank {
    position: fixed;
    width: 0;
    height: 0;
  }

  .dappled-canvas {
    position: fixed !important;
    inset: -8% !important;
    width: 116% !important;
    height: 116% !important;
    opacity: 0.9;
    filter: saturate(1.08) contrast(1.03);
    mix-blend-mode: multiply;
    z-index: 1;
  }

  .bubble-layer {
    position: sticky;
    top: 0;
    height: 100vh;
    margin-bottom: -100vh;
    inset: 0;
    pointer-events: none;
    z-index: 2;
  }

  .bubble-card {
    position: absolute;
    left: var(--x);
    top: var(--y);
    display: grid;
    gap: 0.45rem;
    width: clamp(128px, 15vw, 188px);
    min-height: 86px;
    padding: 16px 18px;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.52);
    border-radius: 999px;
    background:
      linear-gradient(142deg, rgb(255 255 255 / 0.5), rgb(236 247 234 / 0.22) 46%, rgb(255 214 145 / 0.18)),
      rgb(255 255 255 / 0.12);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.88),
      inset 14px 18px 32px rgb(255 255 255 / 0.16),
      0 20px 56px rgb(69 61 42 / 0.16),
      1px 0 0 rgb(255 79 56 / 0.28),
      -1px 0 0 rgb(45 154 255 / 0.3);
    backdrop-filter: blur(20px) saturate(1.42) contrast(1.04);
    filter: url("#bubble-card-glass") drop-shadow(0 14px 30px rgb(85 78 52 / 0.14));
  }

  .bubble-card::before {
    position: absolute;
    inset: 8px 16px auto auto;
    width: 42%;
    height: 28%;
    content: "";
    border-radius: 999px;
    background: rgb(255 255 255 / 0.58);
    filter: blur(7px);
    transform: rotate(-18deg);
  }

  .bubble-card span,
  .bubble-card small {
    position: relative;
    letter-spacing: 0;
  }

  .bubble-card span {
    font-size: clamp(1rem, 1.55vw, 1.35rem);
    font-weight: 600;
  }

  .bubble-card small {
    font-size: 0.72rem;
    color: rgb(39 37 31 / 0.58);
  }

  .signature-shell {
    position: sticky;
    top: 0;
    height: 100vh;
    display: grid;
    place-items: center;
    margin-bottom: -100vh;
    padding: clamp(42px, 8vw, 112px);
    pointer-events: auto;
    z-index: 3;
  }

  .glass-signature {
    width: min(86vw, 1120px);
    height: auto;
    overflow: visible;
    pointer-events: auto;
    filter:
      drop-shadow(0 22px 44px rgb(73 88 70 / 0.16))
      drop-shadow(0 0 18px rgb(255 255 255 / 0.34));
  }

  .glass-signature__ripples {
    mix-blend-mode: screen;
    pointer-events: none;
  }

  .glass-signature__ripple-fill,
  .glass-signature__ripple-ring {
    transform-box: fill-box;
    transform-origin: center;
  }

  .glass-signature__ripple-ring {
    fill: none;
    stroke: rgb(250 255 255 / 0.72);
    stroke-width: 3.4;
    filter:
      drop-shadow(1.1px 0 0 rgb(255 82 62 / 0.22))
      drop-shadow(-1.1px 0 0 rgb(45 166 255 / 0.24));
  }

  .glass-signature__backdrop {
    fill: rgb(255 255 255 / 0.28);
    stroke: rgb(255 255 255 / 0.36);
    stroke-width: 10;
    opacity: 0.72;
    filter: blur(0.2px);
  }

  .glass-signature__path {
    stroke: rgb(250 255 250 / 0.86);
    stroke-width: 10;
    mix-blend-mode: screen;
  }

  .glass-signature__path--red {
    stroke: rgb(255 76 54 / 0.26);
    stroke-width: 8.8;
    mix-blend-mode: screen;
  }

  .glass-signature__path--blue {
    stroke: rgb(35 148 255 / 0.28);
    stroke-width: 8.8;
    mix-blend-mode: screen;
  }

  .glass-signature__path--spark {
    stroke: rgb(255 255 255 / 0.64);
    stroke-width: 3.2;
    stroke-dasharray: 24 72;
    mix-blend-mode: screen;
  }

  .signature-scroll-copy {
    position: relative;
    z-index: 4;
    display: grid;
    gap: 0.55rem;
    width: min(420px, calc(100vw - 48px));
    margin-left: clamp(24px, 9vw, 120px);
    color: rgb(51 45 37 / 0.78);
    font-family: "Maple Mono NF CN", system-ui, sans-serif;
    font-size: clamp(1.05rem, 2.2vw, 1.85rem);
    line-height: 1.18;
    text-shadow: 0 1px 22px rgb(255 247 224 / 0.7);
  }

  .signature-scroll-copy p {
    margin: 0;
  }

  .signature-scroll-copy--middle {
    padding-top: 132vh;
  }

  .signature-scroll-copy--end {
    margin-left: auto;
    margin-right: clamp(24px, 9vw, 120px);
    padding-top: 58vh;
    padding-bottom: 32vh;
    text-align: right;
  }

  @keyframes dapple-drift {
    from {
      transform: translate3d(-1.4%, -0.8%, 0) rotate(-7deg) scale(1);
    }

    to {
      transform: translate3d(1.6%, 1.1%, 0) rotate(-4deg) scale(1.03);
    }
  }

  @media (max-width: 720px) {
    .signature-shell {
      padding: 9vw 4vw;
    }

    .glass-signature {
      width: 112vw;
    }

    .bubble-card {
      width: 126px;
      min-height: 76px;
      padding: 14px 16px;
    }

    .bubble-card:nth-child(2),
    .bubble-card:nth-child(4) {
      left: auto;
      right: 6%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .signature-scene::before {
      animation: none;
    }
  }
</style>
