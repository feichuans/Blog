---
import Base from "@/layouts/Base.astro";

const labs = [
  {
    title: "Presence",
    description: "全站合计在场人数；同页才显示别人的光标",
    href: "/labs/presence",
    tags: ["Realtime", "Durable Object"],
  },
  {
    title: "厚涂 Impasto",
    description: "方向笔触 + 横向融化 + 颜料堆积 + 画布纤维",
    href: "/labs/oil-paint",
    tags: ["WebGL", "Shader"],
  },
  {
    title: "Texture Lab",
    description: "WebGL 后处理引擎，滚动切换纹理效果",
    href: "/labs/texture-lab",
    tags: ["WebGL", "Shader"],
  },
  {
    title: "Layered Parallax Clouds",
    description: "HyperFrames 分层视差云 composition",
    href: "/labs/layered-parallax-clouds",
    tags: ["HyperFrames", "Parallax"],
  },
  {
    title: "Blur · GSAP",
    description: "GSAP 驱动的模糊动画效果",
    href: "/labs/blur-gsap",
    tags: ["GSAP", "Animation"],
  },
  {
    title: "Blur · Motion",
    description: "Motion 库实现的模糊过渡",
    href: "/labs/blur-motion",
    tags: ["Motion", "Animation"],
  },
  {
    title: "Blur · WAAPI",
    description: "Web Animations API 原生模糊动画",
    href: "/labs/blur-waapi",
    tags: ["WAAPI", "Animation"],
  },
  {
    title: "Lenis Scroll",
    description: "Lenis 平滑滚动手感对比（6 种配置）",
    href: "/labs/lenis/default",
    tags: ["Scroll", "Lenis"],
  },
  {
    title: "Noise Pixel",
    description: "Canvas 噪点像素效果",
    href: "/labs/noise-pixel",
    tags: ["Canvas", "Noise"],
  },
  {
    title: "Glass Signature",
    description: "玻璃折射 3D 签名效果",
    href: "/labs/signature-glass-demo",
    tags: ["R3F", "Shader"],
  },
  {
    title: "Dappled Light",
    description: "斑驳光影 shader 基线测试",
    href: "/labs/dappled-baseline",
    tags: ["R3F", "Shader"],
  },
  {
    title: "Tools",
    description: "小工具合集",
    href: "/tools",
    tags: ["Utility"],
  },
];
---

<Base enableIntro={false}>
  <main class="labs-page">
    <header class="labs-header">
      <h1>Labs</h1>
      <p>实验性项目和技术演示的合集</p>
    </header>

    <div class="labs-grid">
      {labs.map((lab) => (
        <a href={lab.href} class="lab-card">
          <div class="lab-card-content">
            <h2>{lab.title}</h2>
            <p>{lab.description}</p>
            <div class="lab-tags">
              {lab.tags.map((tag) => (
                <span class="lab-tag">{tag}</span>
              ))}
            </div>
          </div>
          <span class="lab-arrow">&rarr;</span>
        </a>
      ))}
    </div>
  </main>
</Base>

<style>
  .labs-page {
    max-width: 960px;
    margin: 0 auto;
    padding: 6rem 2rem 4rem;
  }

  .labs-header {
    margin-bottom: 3rem;
  }

  /* --text-primary / --text-secondary 全站没有定义，一直在吃 #1a1a1a / #666
   * 兜底值，暗色下就是深底深字。换成 --fc-* 后跟着 data-fc-theme 走。 */
  .labs-header h1 {
    font-size: 2.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--fc-ink);
  }

  .labs-header p {
    margin-top: 0.5rem;
    font-size: 1.1rem;
    color: var(--fc-ink-meta);
  }

  .labs-grid {
    display: grid;
    gap: 1rem;
  }

  /* 卡片原来是白色 alpha 叠底 + 黑色 alpha 描边：白 alpha 在暗底会发光，
   * 黑 alpha 在暗底会消失。改用 surface / border 这对语义值。 */
  .lab-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 2rem;
    border-radius: 12px;
    border: 1px solid var(--fc-border);
    background: var(--fc-surface-raised);
    text-decoration: none;
    color: inherit;
    transition:
      background var(--fc-motion-hover),
      border-color var(--fc-motion-hover),
      box-shadow var(--fc-motion-hover),
      transform var(--fc-motion-hover);
  }

  .lab-card:hover {
    background: var(--fc-surface-inset);
    border-color: var(--fc-border-strong);
    box-shadow: var(--fc-elev-raised);
    transform: translateY(-1px);
  }

  .lab-card-content h2 {
    font-size: 1.2rem;
    font-weight: 600;
    margin: 0;
    color: var(--fc-ink);
  }

  .lab-card-content p {
    margin: 0.4rem 0 0;
    font-size: 0.9rem;
    color: var(--fc-ink-meta);
  }

  .lab-tags {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.75rem;
    flex-wrap: wrap;
  }

  .lab-tag {
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    border-radius: var(--fc-radius-pill);
    background: var(--fc-surface-sunken);
    color: var(--fc-ink-muted);
    font-weight: 500;
  }

  /* 箭头是纯装饰，用 ink-meta 起步、hover 到 ink，两套 palette 都能看见 */
  .lab-arrow {
    font-size: 1.4rem;
    color: var(--fc-ink-meta);
    transition:
      color var(--fc-motion-hover),
      transform var(--fc-motion-hover);
    flex-shrink: 0;
  }

  .lab-card:hover .lab-arrow {
    color: var(--fc-ink);
    transform: translateX(3px);
  }

  /* 原先这里有一整套 :global(.dark) 覆盖，但全站没有任何代码给元素加 .dark
   * class（global.css 里那个 .dark block 早已作为死代码删除），所以那些规则
   * 从未生效过。上面改成 --fc-* 之后不需要第二套色号，已整块移除。 */
</style>
