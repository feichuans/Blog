---
import { type CollectionEntry, getCollection, render } from "astro:content";
import FormattedDate from "../components/blog/FormattedDate.astro";
import Base from "./Base.astro";
import ReaderControls from "@/components/blog/ReaderControls";
import ScrollIsland from "@/components/blog/ScrollIsland.astro";
import { HoverLinkEnhancer } from "@/components/ui/HoverPreview";

import "../styles/reader-themes.css";

type Props = CollectionEntry<"blog">["data"] & {
  headings?: { depth: number; slug: string; text: string }[];
};

const { title, description, banner, dateCreated, dateModified, tags, headings = [] } =
  Astro.props;
const bannerURL = typeof banner === "string" ? banner : banner?.src;
---

<Base
  ogType="article"
  description={description ?? `${title} — Feichuan 的技术与实践记录。`}
  title={title}
  banner={banner}
  publishedTime={dateCreated}
  modifiedTime={dateModified}
  readerPage
>
  <script is:inline>
    (function () {
      try {
        var s = JSON.parse(localStorage.getItem("blog-reader-settings") || "{}");
        var root = document.getElementById("reader-root");

        // 没存过 reader 皮肤时，从全站 site-theme 推一个 —— 否则从暗色首页点进
        // 文章会突然变亮。连 data-reader-theme 一起推，图标才不会显示 ☀️ 却是暗底。
        var theme = s.theme;
        if (!theme) {
          var t = localStorage.getItem("site-theme");
          if (t !== "light" && t !== "dark") t = "system";
          var systemDark = matchMedia("(prefers-color-scheme: dark)").matches;
          theme = t === "dark" || (t === "system" && systemDark) ? "dark" : "light";
        }

        if (root) root.setAttribute("data-reader-theme", theme);
        // 与 ReaderControls 的 applyToDOM 保持一致：把明暗意图同步到 <html>，
        // 让 token 的 --fc-* palette 跟着切。放在内联脚本里是为了首帧就正确，
        // 等 React 挂载再切会闪一下。这是 readerPage 下 BaseHead 让路的原因：
        // 明暗只在这一处决定。
        var isDark = theme === "dark" || theme === "night";
        document.documentElement.dataset.fcTheme = isDark ? "dark" : "light";
        // theme-color 的近似兜底（此时拿不到 computed style）。night 是低蓝光
        // 深底，跟 dark 不是同一个色号，各给各的；ReaderControls 挂载后会用
        // 真实的 --fc-surface-page 覆盖。
        var m = document.querySelector('meta[name="theme-color"]');
        if (m && isDark) m.content = theme === "night" ? "#0d1117" : "#22201c";
        var article = root && root.querySelector(".reader-article");
        if (article) {
          if (s.fontSize) article.style.fontSize = s.fontSize + "px";
          if (s.lineHeight) article.style.lineHeight = String(s.lineHeight);
          if (s.fontIndex !== undefined) {
            var fonts = [
              '"Noto Serif SC", "Source Han Serif SC", "Songti SC", serif',
              '"Maple Mono NF CN", "Maple Mono", system-ui, sans-serif',
              '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif',
            ];
            if (fonts[s.fontIndex]) article.style.fontFamily = fonts[s.fontIndex];
          }
        }
      } catch (e) {}
    })();
  </script>

  <div id="reader-root" data-reader-theme="light">
    {/* 阅读进度条 */}
    <div class="reader-progress-bar"></div>
    {/* 顶部渐变遮罩 */}
    <div class="reader-mask-top"></div>
    {/* 底部渐变遮罩 */}
    <div class="reader-mask-bottom"></div>

    {/* Content area */}
    <div class="flex items-start w-screen min-h-screen">
      {/* 左侧返回按钮 — 固定居中 */}
      <div class="reader-back-col max-md:hidden">
        <a href="/" class="reader-back" data-astro-prefetch title="返回首页">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </a>
      </div>

      <div class="flex-1 flex justify-center pt-[124px]">
        <div class="reader-article prose prose-lg max-w-3xl w-full px-6 pb-20">
          {/* 标题 */}
          <h1 class="reader-title">{title}</h1>

          {/* 元信息 */}
          <div class="reader-meta">
            <span class="reader-meta-item">
              <svg class="reader-meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              <FormattedDate date={dateCreated} />
            </span>
            {dateModified && (
              <span class="reader-meta-item">
                <svg class="reader-meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <FormattedDate date={dateModified} />
              </span>
            )}
            {tags && tags.length > 0 && (
              <div class="reader-tags">
                {tags.map((tag) => (
                  <span class="reader-tag">{tag}</span>
                ))}
              </div>
            )}
          </div>

          {/* 封面图（可选） */}
          {bannerURL && (
            <div class="reader-cover">
              <img src={bannerURL} alt={title} class="reader-cover-img" loading="eager" />
            </div>
          )}

          {/* 正文 */}
          <slot />
        </div>
        <div class="hover-preview-slot">
          <HoverLinkEnhancer client:only="react" />
        </div>
      </div>

      {/* 右侧栏：设置 */}
      <aside class="sticky top-[124px] w-16 flex flex-col gap-4 pt-[124px] max-md:hidden">
        <div class="flex justify-end pr-4">
          <ReaderControls client:load />
        </div>
      </aside>
    </div>

    <ScrollIsland headings={headings} title={title} />

    {/* 评论 */}
    <div class="max-w-3xl mx-auto px-6 pb-20 g-not">
      <div class="reader-comments-divider"></div>
      <div id="tcomment" class="g-not"></div>
    </div>
  </div>

  <script>
    //@ts-ignore
    import * as twikoo from "twikoo";
    window.addEventListener("load", () => {
      twikoo.init({
        envId: "https://feichuans.netlify.app/.netlify/functions/twikoo",
        el: "#tcomment",
      });
    });

    // 阅读进度条 — 复用 Nav 的 --scroll-p 模式，监听 Lenis 或原生滚动
    const bar = document.querySelector(".reader-progress-bar") as HTMLElement;
    if (bar) {
      const update = (scroll: number, limit: number) => {
        const p = limit > 0 ? Math.min(1, Math.max(0, scroll / limit)) : 0;
        bar.style.setProperty("--reading-progress", String(p));
      };
      window.addEventListener("lenis-scroll", (e: Event) => {
        const { scroll, limit } = (e as CustomEvent).detail;
        update(scroll, limit);
      });
      window.addEventListener("scroll", () => {
        const scroll = window.scrollY;
        const limit =
          document.documentElement.scrollHeight - window.innerHeight;
        update(scroll, limit);
      });
    }
  </script>
</Base>

<style>
  /* 阅读进度条 — 贴住视口顶部；top: 28px 曾是给已移除的 AnnouncementBar 预留的偏移 */
  .reader-progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    width: calc(var(--reading-progress, 0) * 100%);
    background: var(--reader-link);
    z-index: 50;
    transition: width 0.1s linear;
    pointer-events: none;
  }

  /* 预览岛不能占 flex 宽度，否则正文 max-w-3xl 会被挤窄 */
  .hover-preview-slot {
    position: absolute;
    width: 0;
    height: 0;
    overflow: visible;
    pointer-events: none;
  }

  /* 左侧返回按钮列 — sticky 垂直居中 */
  .reader-back-col {
    position: sticky;
    top: 50vh;
    transform: translateY(-50%);
    width: 72px;
    display: flex;
    justify-content: center;
    flex-shrink: 0;
    z-index: 10;
  }
  .reader-back {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    color: var(--reader-secondary);
    text-decoration: none !important;
    transition: color 0.4s ease, background-color 0.4s ease, border-color 0.4s ease;
    cursor: pointer;
    background: var(--reader-ctrl-bg);
    border: 1px solid var(--reader-ctrl-border);
    backdrop-filter: blur(12px);
  }
  .reader-back:hover {
    color: var(--reader-text);
    background: var(--reader-ctrl-hover);
  }

  /* 顶部/底部渐变遮罩 */
  .reader-mask-top,
  .reader-mask-bottom {
    position: fixed;
    left: 0;
    right: 0;
    height: 3rem;
    pointer-events: none;
    z-index: 5;
  }
  .reader-mask-top {
    top: 0;
    background: linear-gradient(to bottom, color-mix(in srgb, var(--reader-bg) 80%, transparent), transparent);
  }
  .reader-mask-bottom {
    bottom: 0;
    background: linear-gradient(to top, color-mix(in srgb, var(--reader-bg) 80%, transparent), transparent);
  }

  /* 标题 */
  .reader-title {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--reader-heading);
    margin-bottom: 1.5rem;
    letter-spacing: -0.01em;
    transition: color 0.4s ease;
  }

  /* 元信息栏 */
  .reader-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    font-size: 0.875rem;
    color: var(--reader-secondary);
    padding-bottom: 1.5rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--reader-border);
    transition: color 0.4s ease, border-color 0.4s ease;
  }
  .reader-meta-item {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }
  .reader-meta-icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  /* 标签 */
  .reader-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .reader-tag {
    font-size: 0.75rem;
    padding: 0.125rem 0.5rem;
    border-radius: 9999px;
    border: 1px solid var(--reader-border);
    color: var(--reader-secondary);
    transition: color 0.4s ease, border-color 0.4s ease;
  }

  /* 封面图 */
  .reader-cover {
    margin-bottom: 2rem;
  }
  .reader-cover-img {
    width: 100%;
    border-radius: 1rem;
    object-fit: cover;
    max-height: 400px;
  }

  /* 评论分隔线 */
  .reader-comments-divider {
    height: 1px;
    background: var(--reader-border);
    margin-bottom: 2rem;
    transition: background-color 0.4s ease;
  }
</style>
