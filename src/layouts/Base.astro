---
import BaseHead from "../components/layout/BaseHead.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import Mouse from "../components/layout/Mouse.astro";
import SiteMenu from "@/components/layout/SiteMenu.astro";
import OnDevMode from "@/components/layout/OnDevMode.astro";
import Footer from "@/components/layout/Footer.astro";
import ThemeToggle from "@/components/layout/ThemeToggle.astro";

import "../styles/global.css";
export type Props = {
  title?: string;
  description?: string;
  banner?: ImageMetadata | string;
  enableIntro?: boolean;
  ogType?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
  showMouse?: boolean;
  showDev?: boolean;
  showFooter?: boolean;
  showMenu?: boolean;
  /** 文章页置 true：明暗交给 reader 皮肤，BaseHead 不再写首帧主题。 */
  readerPage?: boolean;
};

const {
  title = "",
  description = SITE_DESCRIPTION,
  banner,
  enableIntro = false,
  ogType = "website",
  publishedTime,
  modifiedTime,
  showMouse = true,
  showDev = true,
  showFooter = true,
  showMenu = true,
  readerPage = false,
}: Props = Astro.props;
---

<!doctype html>
<html lang="zh-cn">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={banner}
      ogType={ogType}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      readerPage={readerPage}
    />
  </head>
  <body>
    <slot name="intro" />
    {showDev && <OnDevMode />}
    {showMouse && <Mouse />}
    {showMenu && <SiteMenu />}
    {/* 文章页的明暗归 ReaderControls 管，不放第二个入口 */}
    {showMenu && !readerPage && <ThemeToggle />}

    <div class:list={["smooth-wrapper", enableIntro && "slot"]}>
      <div
        class="background w-full smooth-content"
      >
        <slot />
        {showFooter && <Footer />}
      </div>
    </div>

    <script>
      import { applyFcTheme, watchSystemTheme } from "@/lib/theme";
      // 首帧已由 BaseHead 的内联脚本处理；这里只补 theme-color（需要 computed
      // style，内联脚本跑在样式表之前拿不到）并接上系统偏好变化的监听。
      applyFcTheme();
      watchSystemTheme();
    </script>

    <script define:vars={{ enableIntro }}>
      if (!enableIntro) {
        // 等 DOM ready，确保菜单模块脚本已执行并注册了监听器
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", function () {
            window.dispatchEvent(new Event("Intro:end"));
          });
        } else {
          window.dispatchEvent(new Event("Intro:end"));
        }
      }
    </script>
    <script>
      import Lenis from "lenis";
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";
      gsap.registerPlugin(ScrollTrigger);

      // 获取滚动容器
      const wrapper = document.querySelector(".smooth-wrapper");

      // 初始化 Lenis - 针对特定容器的虚拟滚动
      const lenis = new Lenis({
        wrapper: wrapper, // 滚动容器
        content: document.querySelector(".smooth-content"), // 内容元素
        duration: 1, // 滚动动画持续时间
        easing: (x) => (x === 1 ? 1 : 1 - Math.pow(2, -10 * x)), // 缓动函数
        orientation: "vertical", // 滚动方向
        gestureOrientation: "vertical", // 手势方向
        smoothWheel: true, // 平滑鼠标滚轮
        wheelMultiplier: 1.2, // 滚轮速度倍数
        syncTouch: false, // 触屏保留原生滚动，桌面继续使用平滑滚轮。
        infinite: false, // 是否无限滚动
      });

      // 配置 ScrollTrigger 使用自定义滚动容器
      ScrollTrigger.scrollerProxy(".smooth-wrapper", {
        scrollTop(value) {
          if (arguments.length) {
            lenis.scrollTo(value, { immediate: true });
          }
          return lenis.scroll;
        },
        getBoundingClientRect() {
          return {
            top: 0,
            left: 0,
            width: window.innerWidth,
            height: window.innerHeight,
          };
        },
        pinType: wrapper.style.transform ? "transform" : "fixed",
      });

      // 同步 Lenis 滚动与 GSAP ScrollTrigger
      lenis.on("scroll", ({ scroll, limit }) => {
        // 发送自定义事件给菜单组件
        window.dispatchEvent(
          new CustomEvent("lenis-scroll", {
            detail: { scroll, limit },
          }),
        );
        ScrollTrigger.update();
      });

      // 将 Lenis 的 RAF 添加到 GSAP ticker
      gsap.ticker.add((time) => {
        lenis.raf(time * 1000);
      });

      // 禁用 GSAP 的 lag smoothing
      gsap.ticker.lagSmoothing(0);

      // 监听 ScrollTrigger 的刷新事件
      ScrollTrigger.addEventListener("refresh", () => lenis.resize());
    </script>
    <style>
      .smooth-wrapper {
        width: 100%;
        height: 100vh;
        height: 100dvh;
        overflow-x: hidden;
        overflow-y: auto;
      }

      .smooth-content {
        min-height: 100vh;
      }

      .slot {
        --clip-top: 50%;
        --clip-right: 38%;
        --clip-bottom: 50%;
        --clip-left: 38%;
        --clip-height: 100vh;
        --clip-width: 100%;
        clip-path: inset(
          var(--clip-top) var(--clip-right) var(--clip-bottom) var(--clip-left)
        );
        height: var(--clip-height);
        width: var(--clip-width);
      }

      @supports (height: 100dvh) {
        .slot {
          --clip-height: 100dvh;
        }
      }
    </style>
  </body>
</html>
